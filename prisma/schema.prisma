generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE

  @@map("tipo_usuarios")
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO

  @@map("tipo_status")
}

enum OrderChannel {
  APP
  TOTEM
  BALCAO
  WEB

  @@map("canal_pedido")
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO

  @@map("pagamento_status")
}

enum PaymentMethod {
  PIX
  DEBITO
  CREDITO

  @@map("pagamento_metodo")
}

enum PointsType {
  DEBITO
  CREDITO

  @@map("tipo_pontos")
}

enum LoyaltyStatus {
  DISPONIVEL
  VINCULADO
  UTILIZADO
  EXPIRADO

  @@map("fidelidade_status")
}

enum CancellationOrigin {
  CLIENTE
  ESTABELECIMENTO
  SISTEMA

  @@map("origem")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String          @map("nome")
  email          String          @unique
  phone          String          @map("telefone")
  profile        UserType        @map("perfil")
  passwordHash   String          @map("senha_hash")
  active         Boolean         @default(true) @map("ativo")
  createdAt      DateTime        @default(now()) @map("data_registro")
  updatedAt      DateTime        @updatedAt @map("data_atualizacao")
  unitId         Int?            @map("unidade_id")
  unit           Unit?           @relation(fields: [unitId], references: [id])
  createdOrders  Order[]         @relation("CreatedBy")
  customerOrders Order[]         @relation("Customer")
  loyaltyProgram LoyaltyProgram?
  cancellations  Cancellation[]

  @@map("usuario")
}

model Unit {
  id         Int         @id @default(autoincrement())
  name       String      @map("nome")
  street     String      @map("logradouro")
  phone      String      @map("telefone")
  city       String      @map("cidade")
  state      String      @map("estado")
  number     String      @map("numero")
  zipCode    String      @map("cep")
  active     Boolean     @default(true) @map("ativo")
  createdAt  DateTime    @default(now()) @map("data_registro")
  updatedAt  DateTime    @updatedAt @map("data_atualizacao")
  users      User[]
  unitStocks UnitStock[]
  orders     Order[]

  @@map("unidade")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @map("nome")
  description String      @map("descricao")
  price       Decimal     @map("preco") @db.Decimal(10, 2)
  active      Boolean     @default(true) @map("ativo")
  createdAt   DateTime    @default(now()) @map("data_registro")
  updatedAt   DateTime    @updatedAt @map("data_atualizacao")
  unitStocks  UnitStock[]
  orderItems  OrderItem[]

  @@map("produto")
}

model UnitStock {
  id        Int      @id @default(autoincrement())
  quantity  Int      @map("quantidade")
  available Boolean  @default(true) @map("disponivel")
  createdAt DateTime @default(now()) @map("data_registro")
  updatedAt DateTime @updatedAt @map("data_atualizacao")
  unitId    Int      @map("unidade_id")
  unit      Unit     @relation(fields: [unitId], references: [id])
  productId Int      @map("produto_id")
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([unitId, productId])
  @@map("estoque_unidade")
}

model Order {
  id             Int             @id @default(autoincrement())
  status         OrderStatus     @default(AGUARDANDO_PAGAMENTO) @map("status")
  orderChannel   OrderChannel    @map("canal_pedido")
  createdAt      DateTime        @default(now()) @map("data_registro")
  updatedAt      DateTime        @updatedAt @map("data_atualizacao")
  customerId     Int             @map("cliente_id")
  customer       User            @relation("Customer", fields: [customerId], references: [id])
  createdById    Int             @map("criado_por")
  createdBy      User            @relation("CreatedBy", fields: [createdById], references: [id])
  unitId         Int             @map("unidade_id")
  unit           Unit            @relation(fields: [unitId], references: [id])
  campaignId     Int?            @map("campanha_id")
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  totalValue     Decimal         @map("valor_total") @db.Decimal(10, 2)
  orderItems     OrderItem[]
  payments       Payment[]
  pointMovements PointMovement[]
  loyaltyBenefit LoyaltyBenefit?
  cancellation   Cancellation?

  @@map("pedido")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("pedido_id")
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int      @map("produto_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @map("quantidade")
  unitPrice Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("data_registro")
  updatedAt DateTime @updatedAt @map("data_atualizacao")

  @@unique([orderId, productId])
  @@map("item_pedido")
}

model Payment {
  id               Int           @id @default(autoincrement())
  orderId          Int           @map("pedido_id")
  order            Order         @relation(fields: [orderId], references: [id])
  status           PaymentStatus @default(PENDENTE)
  totalValue       Decimal       @map("valor") @db.Decimal(10, 2)
  method           PaymentMethod @map("metodo")
  uniqueIdentifier String        @unique @map("identificador_unico")
  createdAt        DateTime      @default(now()) @map("data_registro")
  updatedAt        DateTime      @updatedAt @map("data_atualizacao")

  @@map("pagamento")
}

model LoyaltyProgram {
  id              Int              @id @default(autoincrement())
  customerId      Int              @unique @map("cliente_id")
  customer        User             @relation(fields: [customerId], references: [id])
  pointsBalance   Int              @map("saldo_pontos")
  consent         Boolean          @default(false) @map("consentimento")
  createdAt       DateTime         @default(now()) @map("data_registro")
  updatedAt       DateTime         @updatedAt @map("data_atualizacao")
  pointMovements  PointMovement[]
  loyaltyBenefits LoyaltyBenefit[]

  @@map("programa_pontos")
}

model PointMovement {
  id               Int            @id @default(autoincrement())
  loyaltyProgramId Int            @map("programa_pontos_id")
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id])
  orderId          Int            @map("pedido_id")
  order            Order          @relation(fields: [orderId], references: [id])
  type             PointsType     @map("tipo")
  createdAt        DateTime       @default(now()) @map("data_registro")
  updatedAt        DateTime       @updatedAt @map("data_atualizacao")
  pointsAmount     Int            @map("quantidade_pontos")

  @@map("movimentacao_pontos")
}

model LoyaltyBenefit {
  id               Int            @id @default(autoincrement())
  loyaltyProgramId Int            @map("programa_pontos_id")
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id])
  orderId          Int?           @unique @map("pedido_id")
  order            Order?         @relation(fields: [orderId], references: [id])
  status           LoyaltyStatus  @default(DISPONIVEL)
  maximumValue     Decimal        @map("valor_maximo") @db.Decimal(10, 2)
  valueUsed        Decimal?       @map("valor_utilizado") @db.Decimal(10, 2)
  releaseDate      DateTime       @default(now()) @map("data_liberacao")
  expirationDate   DateTime       @map("data_expiracao")
  usedDate         DateTime?      @map("data_utilizacao")
  createdAt        DateTime       @default(now()) @map("data_registro")
  updatedAt        DateTime       @updatedAt @map("data_atualizacao")

  @@map("beneficio_fidelidade")
}

model Cancellation {
  id        Int                @id @default(autoincrement())
  orderId   Int                @unique @map("pedido_id")
  order     Order              @relation(fields: [orderId], references: [id])
  userId    Int?               @map("usuario_id")
  user      User?              @relation(fields: [userId], references: [id])
  origin    CancellationOrigin @map("origem")
  reason    String             @map("motivo")
  createdAt DateTime           @default(now()) @map("data_registro")
  updatedAt DateTime           @updatedAt @map("data_atualizacao")

  @@map("cancelamento")
}

model Campaign {
  id                 Int      @id @default(autoincrement())
  name               String   @map("nome")
  description        String   @map("descricao")
  discountPercentage Decimal  @map("percentual_desconto") @db.Decimal(10, 2)
  startDate          DateTime @map("data_inicio")
  endDate            DateTime @map("data_fim")
  createdAt          DateTime @default(now()) @map("data_registro")
  updatedAt          DateTime @updatedAt @map("data_atualizacao")
  active             Boolean  @default(true) @map("ativo")
  orders             Order[]

  @@map("campanha")
}
